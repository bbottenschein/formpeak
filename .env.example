# Supabase (Project Settings → API), EU-Region. Der Publishable Key darf in den Browser.
NEXT_PUBLIC_SUPABASE_URL=https://<projekt>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Nur serverseitig – niemals mit NEXT_PUBLIC_ beginnen lassen.
SUPABASE_SECRET_KEY=
# Schützt /api/jobs/* – z. B. mit `openssl rand -hex 32` erzeugen.
JOBS_SECRET=

# Web Push. Erzeugen mit: npx web-push generate-vapid-keys
# Der öffentliche Schlüssel wird vom Server an den Browser gegeben.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:deine-adresse@example.com

# Claude API für KI-Funktionen (Ziel formulieren, ab Phase 2 Wochenplan). Optional.
ANTHROPIC_API_KEY=
